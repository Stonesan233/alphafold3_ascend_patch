+def get_device() -> torch.device:
+    """Auto-detect best available device: NPU > CUDA > CPU.
+
+    The card can be overridden with the AF3_DEVICE environment variable,
+    e.g. AF3_DEVICE=npu:5 or AF3_DEVICE=cuda:1. Defaults to index 0.
+    """
+    env_device = os.environ.get('AF3_DEVICE')
+    if env_device:
+        return torch.device(env_device)
+    try:
+        import torch_npu  # noqa: F401
+        if hasattr(torch, 'npu') and torch.npu.is_available():
+            return torch.device('npu:0')
+    except ImportError:
+        pass
+    if torch.cuda.is_available():
+        return torch.device('cuda:0')
+    return torch.device('cpu')
+
+
+def device_sync(device: torch.device) -> None:
+    """Synchronize the given device (no-op on CPU)."""
+    if device.type == 'npu':
+        torch.npu.synchronize()
+    elif device.type == 'cuda':
+        torch.cuda.synchronize()
+
+
+def _use_bf16_autocast(device: torch.device, precision: str) -> bool:
+    if precision == 'fp32':
+        return False
+    if precision == 'bf16':
+        return device.type in ('cuda', 'npu')
+    # auto: bf16 on CUDA only. NPU/CPU run float32.
+    return device.type == 'cuda'
+
 
